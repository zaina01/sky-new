# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS node-runtime
FROM eclipse-temurin:25-jdk-noble AS build
WORKDIR /workspace
COPY . .
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew
RUN --mount=type=cache,target=/root/.gradle ./gradlew --no-daemon :sky-job:bootJar :sky-plugin-runner-java:jar

FROM eclipse-temurin:25-jdk-noble AS runtime
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3.12 python3.12-venv curl tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && groupadd --gid 10001 sky && useradd --uid 10001 --gid sky --create-home --home-dir /home/sky sky \
    && mkdir -p /app/data/plugins && chown -R sky:sky /app
RUN ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo Asia/Shanghai > /etc/timezone
WORKDIR /app
COPY --from=build /workspace/sky-job/build/libs/sky-job-1.0-SNAPSHOT.jar /app/app.jar
COPY --from=build /workspace/sky-plugin-runner-java/build/libs/sky-plugin-runner-java-1.0-SNAPSHOT.jar /app/runner.jar
COPY sky-plugin-runner-node /app/sky-plugin-runner-node
COPY sky-plugin-runner-python /app/sky-plugin-runner-python
COPY sky-plugin-protocol/src/main/proto /app/sky-plugin-protocol/src/main/proto
RUN cd /app/sky-plugin-runner-node && npm ci --omit=dev --no-audit --no-fund && npm run build \
    && python3.12 -m venv /tmp/runner-build \
    && /tmp/runner-build/bin/python -m pip install -r /app/sky-plugin-runner-python/requirements-build.txt \
    && /tmp/runner-build/bin/python /app/sky-plugin-runner-python/generate.py \
    && rm -rf /tmp/runner-build
ENV TZ=Asia/Shanghai \
    SKY_PLUGIN_JAVA_COMMAND=/opt/java/openjdk/bin/java \
    SKY_PLUGIN_RUNNER_JAR=/app/runner.jar \
    SKY_PLUGIN_STORAGE_ROOT=/app/data/plugins \
    SKY_PLUGIN_ARTIFACT_ROOT=/app/data/plugins/artifacts \
    SKY_PLUGIN_RUNTIME_WORK_ROOT=/app/data/plugins/runtime \
    SKY_PLUGIN_RUNTIME_LOG_ROOT=/app/data/plugins/logs \
    SKY_PLUGIN_MAVEN_REPOSITORY_ROOT=/app/data/plugins/maven-repository \
    SKY_PLUGIN_SCRIPT_ROOT=/app/data/plugins/script-environments \
    SKY_PLUGIN_NODE_COMMAND=/usr/local/bin/node \
    SKY_PLUGIN_PYTHON_COMMAND=/usr/bin/python3.12 \
    SKY_PLUGIN_NPM_CLI=/usr/local/lib/node_modules/npm/bin/npm-cli.js
USER sky:sky
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 CMD curl --fail --silent http://127.0.0.1:8080/api/actuator/health > /dev/null || exit 1
ENTRYPOINT ["/opt/java/openjdk/bin/java", "-jar", "/app/app.jar"]
