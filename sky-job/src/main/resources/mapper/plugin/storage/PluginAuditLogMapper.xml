<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.job.plugin.storage.mapper.PluginAuditLogMapper">
    <resultMap id="PluginAuditLogResultMap" type="com.sky.job.plugin.storage.PluginAuditLog">
        <constructor>
            <arg column="id" javaType="java.lang.Long"/>
            <arg column="plugin_id" javaType="java.lang.String"/>
            <arg column="instance_id" javaType="java.lang.String"/>
            <arg column="actor" javaType="java.lang.String"/>
            <arg column="action" javaType="java.lang.String"/>
            <arg column="detail_json" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO plugin_audit_log (plugin_id, instance_id, actor, action, detail_json)
        VALUES (#{pluginId}, #{instanceId}, #{actor}, #{action}, CAST(#{detailJson} AS JSON))
    </insert>

    <sql id="filters">
        <where>
            <if test="pluginId != null and pluginId != ''">
                plugin_id = #{pluginId}
            </if>
            <if test="instanceId != null and instanceId != ''">
                AND instance_id = #{instanceId}
            </if>
            <if test="actor != null and actor != ''">
                AND actor LIKE #{actorLike}
            </if>
            <if test="action != null and action != ''">
                AND action = #{action}
            </if>
            <if test="startTime != null">
                AND created_at &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND created_at &lt;= #{endTime}
            </if>
        </where>
    </sql>

    <select id="list" resultMap="PluginAuditLogResultMap">
        SELECT *
        FROM plugin_audit_log
        <include refid="filters"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM plugin_audit_log
        <include refid="filters"/>
    </select>

    <select id="countOlderThan" resultType="long">
        SELECT COUNT(*)
        FROM plugin_audit_log
        WHERE created_at &lt; #{cutoff}
    </select>

    <delete id="deleteOlderThan">
        DELETE FROM plugin_audit_log
        WHERE created_at &lt; #{cutoff}
        ORDER BY id
        LIMIT #{limit}
    </delete>
</mapper>
