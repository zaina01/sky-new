<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.job.plugin.storage.mapper.PluginAuditLogMapper">
    <resultMap id="PluginAuditLogResultMap" type="com.sky.job.plugin.storage.PluginAuditLog">
        <constructor>
            <arg column="id" javaType="java.lang.Long"/>
            <arg column="installation_id" javaType="java.lang.String"/>
            <arg column="plugin_id" javaType="java.lang.String"/>
            <arg column="instance_id" javaType="java.lang.String"/>
            <arg column="actor" javaType="java.lang.String"/>
            <arg column="action" javaType="java.lang.String"/>
            <arg column="detail_json" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO plugin_audit_log (
          installation_id, plugin_id, instance_id, owner_user_id, owner_dept_id,
          actor, action, detail_json
        )
        VALUES (
          #{installationId}, #{pluginId}, #{instanceId},
          (SELECT owner_user_id FROM plugin_installation WHERE installation_id = #{installationId}),
          (SELECT owner_dept_id FROM plugin_installation WHERE installation_id = #{installationId}),
          #{actor}, #{action}, CAST(#{detailJson} AS JSON)
        )
    </insert>

    <sql id="filters">
        <where>
            <if test="installationId != null and installationId != ''">
                l.installation_id = #{installationId}
            </if>
            <if test="pluginId != null and pluginId != ''">
                AND l.plugin_id = #{pluginId}
            </if>
            <if test="instanceId != null and instanceId != ''">
                AND l.instance_id = #{instanceId}
            </if>
            <if test="actor != null and actor != ''">
                AND l.actor LIKE #{actorLike}
            </if>
            <if test="action != null and action != ''">
                AND l.action = #{action}
            </if>
            <if test="startTime != null">
                AND l.created_at &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND l.created_at &lt;= #{endTime}
            </if>
            <if test="scope != null and !scope.all">
                AND <choose>
                    <when test="scope.denied">1 = 0</when>
                    <otherwise>(
                        <if test="scope.departmentIds != null and !scope.departmentIds.isEmpty()">
                            l.owner_dept_id IN <foreach collection="scope.departmentIds" item="deptId" open="(" separator="," close=")">#{deptId}</foreach>
                        </if>
                        <if test="scope.self">
                            <if test="scope.departmentIds != null and !scope.departmentIds.isEmpty()"> OR </if>
                            l.owner_user_id = #{scope.userId}
                        </if>
                    )</otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <select id="list" resultMap="PluginAuditLogResultMap">
        SELECT l.*
        FROM plugin_audit_log l
        <include refid="filters"/>
        ORDER BY l.created_at DESC, l.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM plugin_audit_log l
        <include refid="filters"/>
    </select>

    <select id="countOlderThan" resultType="long">
        SELECT COUNT(*)
        FROM plugin_audit_log
        WHERE created_at &lt; #{cutoff}
    </select>

    <delete id="deleteOlderThan">
        DELETE FROM plugin_audit_log
        WHERE created_at &lt; #{cutoff}
        ORDER BY id
        LIMIT #{limit}
    </delete>
</mapper>
