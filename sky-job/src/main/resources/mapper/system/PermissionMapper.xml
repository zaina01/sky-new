<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.job.system.mapper.PermissionMapper">
    <resultMap id="PermissionResultMap" type="com.sky.job.system.Permission">
        <constructor>
            <arg column="permission_id" javaType="java.lang.Long"/>
            <arg column="permission_name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="filters">
        <where>
            <if test="permissionName != null and permissionName != ''">
                permission_name LIKE #{permissionNameLike}
            </if>
        </where>
    </sql>

    <select id="list" resultMap="PermissionResultMap">
        SELECT *
        FROM sky_permission
        <include refid="filters"/>
        ORDER BY permission_name ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM sky_permission
        <include refid="filters"/>
    </select>

    <select id="existingNames" resultType="java.lang.String">
        SELECT permission_name
        FROM sky_permission
        WHERE permission_name IN
        <foreach collection="permissionNames" item="permissionName" open="(" separator="," close=")">
            #{permissionName}
        </foreach>
    </select>
</mapper>
