# Copy to .env. Secrets are deliberately empty: compose refuses to start until set.
SKY_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# At least 32 random ASCII bytes; e.g. openssl rand -hex 32
SKY_JWT_SECRET=

# Independent immutable release tags are recommended in production.
BACKEND_TAG=latest
FRONTEND_TAG=latest
SKY_HTTP_BIND=0.0.0.0
SKY_HTTP_PORT=80
SKY_PLUGIN_MAX_HEAP=256m
# Host JVM only; plugin JVMs have their own heap limit above.
SKY_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50.0
