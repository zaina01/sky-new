### 通知历史稳定 ID 快照
GET {{baseUrl}}/notifications/history?jobId={{jobId}}&page=1&size=20
Authorization: Bearer {{adminToken}}

> {% client.test("历史返回来源、渠道和安装 ID 快照", function () { const item=response.body.data.items[0]; client.assert(!!item.sourceOwnerUserId); client.assert(!!item.channelOwnerUserId); client.assert(item.installationId === client.global.get("installationB")); }); %}

