@baseUrl = http://localhost:18080/api
@adminUsername = frontend_it_admin
@adminPassword = FrontendIt!2026
@targetUsername = frontend_it_target
@targetPassword = FrontendIt!2026

### 管理员登录
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

> {%
client.test("管理员登录成功", function () {
  client.assert(response.status === 200);
  client.assert(response.body.code === 0);
});
client.global.set("adminToken", response.body.data.token);
%}

### 获取两个同定义安装实例并保存 ID
GET {{baseUrl}}/plugins/installations?pluginId=frontend-integration&page=1&size=20
Authorization: Bearer {{adminToken}}

> {%
client.test("双实例及真实 total", function () {
  client.assert(response.body.data.total >= 2);
});
const items = response.body.data.items;
client.global.set("installationA", items.find(item => item.installationName === "Frontend IT A").installationId);
client.global.set("installationB", items.find(item => item.installationName === "Frontend IT B").installationId);
%}

### 获取 SERVICE 实例并保存 ID
GET {{baseUrl}}/plugins/installations?pluginId=frontend-integration-service&page=1&size=20
Authorization: Bearer {{adminToken}}

> {%
const service = response.body.data.items.find(item => item.installationName === "Frontend IT Echo Service");
client.test("存在真实 SERVICE 实例", function () {
  client.assert(response.body.data.total >= 1);
  client.assert(!!service);
  client.assert(service.pluginId === "frontend-integration-service");
});
client.global.set("serviceInstallation", service.installationId);
%}

### P0：实例 A 渠道池读取
GET {{baseUrl}}/plugins/installations/{{installationA}}/notification-channels
Authorization: Bearer {{adminToken}}

> {%
client.test("实例 A 只返回自己的渠道池", function () {
  client.assert(response.body.code === 0);
  client.assert(JSON.stringify(response.body.data) === JSON.stringify(["frontend-it-channel-a"]));
});
%}

### P0：实例 B 渠道池读取
GET {{baseUrl}}/plugins/installations/{{installationB}}/notification-channels
Authorization: Bearer {{adminToken}}

> {%
client.test("实例 B 只返回自己的渠道池", function () {
  client.assert(response.body.code === 0);
  client.assert(JSON.stringify(response.body.data) === JSON.stringify(["frontend-it-channel-b"]));
});
%}

### 实例 A 配置
GET {{baseUrl}}/plugins/installations/{{installationA}}/config
Authorization: Bearer {{adminToken}}

> {% client.test("实例 A 配置隔离", function () { client.assert(response.body.data.configJson.includes("config-a")); }); %}

### 实例 B 配置
GET {{baseUrl}}/plugins/installations/{{installationB}}/config
Authorization: Bearer {{adminToken}}

> {% client.test("实例 B 配置隔离", function () { client.assert(response.body.data.configJson.includes("config-b")); }); %}

### 实例 A 账户分页
GET {{baseUrl}}/plugins/installations/{{installationA}}/accounts?page=1&size=1
Authorization: Bearer {{adminToken}}

> {% client.test("实例 A 账户与 total", function () { client.assert(response.body.data.total === 1); client.assert(response.body.data.items[0].accountId === "account-a"); }); %}

### Account list column preference candidates
GET {{baseUrl}}/plugins/installations/{{installationA}}/accounts/view-preference
Authorization: Bearer {{adminToken}}

> {%
client.test("Only non-sensitive account fields are selectable", function () {
  const fields = response.body.data.availableFields.map(field => field.name);
  client.assert(JSON.stringify(fields) === JSON.stringify(["region", "expireAt"]));
  client.assert(response.body.data.maxFields === 5);
});
%}

### Save ordered account list columns
PUT {{baseUrl}}/plugins/installations/{{installationA}}/accounts/view-preference
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fields": ["expireAt", "region"]
}

> {%
client.test("Account list column order is persisted", function () {
  client.assert(JSON.stringify(response.body.data.fields) === JSON.stringify(["expireAt", "region"]));
});
%}

### Account list contains only the safe projection
GET {{baseUrl}}/plugins/installations/{{installationA}}/accounts?page=1&size=1
Authorization: Bearer {{adminToken}}

> {%
client.test("Account list never exposes accountJson or secret", function () {
  const item = response.body.data.items[0];
  client.assert(item.accountJson === undefined);
  client.assert(item.displayValues.region === "east");
  client.assert(JSON.stringify(item).indexOf("secret-a") < 0);
});
%}

### Installation B account page
GET {{baseUrl}}/plugins/installations/{{installationB}}/accounts?page=1&size=1
Authorization: Bearer {{adminToken}}

> {% client.test("实例 B 账户与 total", function () { client.assert(response.body.data.total === 1); client.assert(response.body.data.items[0].accountId === "account-b"); }); %}

### 完整部门树必须包含停用节点
GET {{baseUrl}}/system/departments
Authorization: Bearer {{adminToken}}

> {% client.test("完整树包含停用部门", function () { client.assert(JSON.stringify(response.body.data).includes("Frontend IT Legacy Disabled")); }); %}

### CUSTOM 角色必须保留停用部门 ID
GET {{baseUrl}}/system/roles?roleName=FRONTEND_IT_CUSTOM&page=1&size=20
Authorization: Bearer {{adminToken}}

> {% client.test("CUSTOM 停用部门未丢失", function () { client.assert(response.body.data.items[0].departmentIds.length === 1); }); %}

### 本地依赖仓库分页
GET {{baseUrl}}/plugins/dependencies/local-artifacts?page=1&size=1
Authorization: Bearer {{adminToken}}

> {% client.test("依赖仓库返回 items/page/size/total", function () { client.assert(response.body.data.total >= 1); client.assert(response.body.data.items[0].coordinate === "com.sky.it:frontend-helper:1.0.0"); }); %}

### 获取任务并保存 jobId
GET {{baseUrl}}/jobs?page=1&size=20
Authorization: Bearer {{adminToken}}

> {%
const job = response.body.data.items.find(item => item.jobName === "Frontend IT Job");
client.global.set("jobId", job.id.toString());
client.test("任务实例和渠道一致", function () {
  client.assert(job.pluginInstallationId === client.global.get("installationB"));
  client.assert(JSON.stringify(job.notificationChannelIds) === JSON.stringify(["frontend-it-channel-b"]));
});
%}

### 服务权限非空列表并保存 permissionId
GET {{baseUrl}}/plugin-service/permissions?callerInstallationId={{installationB}}&targetInstallationId={{serviceInstallation}}&operation=echo&page=1&size=20
Authorization: Bearer {{adminToken}}

> {%
client.test("服务权限使用真实非空 total", function () {
  client.assert(response.body.data.total === 1);
  client.assert(response.body.data.items[0].targetPluginId === "frontend-integration-service");
  client.assert(response.body.data.items[0].operation === "echo");
});
client.global.set("servicePermissionId", response.body.data.items[0].id.toString());
%}

### 服务权限详情
GET {{baseUrl}}/plugin-service/permissions/{{servicePermissionId}}
Authorization: Bearer {{adminToken}}

> {% client.test("服务权限详情可读", function () { client.assert(response.body.data.id.toString() === client.global.get("servicePermissionId")); }); %}

### 服务权限停用
PATCH {{baseUrl}}/plugin-service/permissions/{{servicePermissionId}}/enabled
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "enabled": false
}

> {% client.test("服务权限已停用", function () { client.assert(response.body.data.enabled === false); }); %}

### 服务权限重新启用
PATCH {{baseUrl}}/plugin-service/permissions/{{servicePermissionId}}/enabled
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "enabled": true
}

> {% client.test("服务权限已启用", function () { client.assert(response.body.data.enabled === true); }); %}

### 服务权限删除
DELETE {{baseUrl}}/plugin-service/permissions/{{servicePermissionId}}
Authorization: Bearer {{adminToken}}

> {% client.test("服务权限删除成功", function () { client.assert(response.body.data.success === true); }); %}

### 服务权限重建，保留后续调用所需白名单
POST {{baseUrl}}/plugin-service/permissions
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "callerInstallationId": "{{installationB}}",
  "targetInstallationId": "{{serviceInstallation}}",
  "operation": "echo",
  "enabled": true
}

> {%
client.test("服务权限重建成功", function () {
  client.assert(response.body.data.enabled === true);
  client.assert(response.body.data.targetPluginId === "frontend-integration-service");
});
client.global.set("servicePermissionId", response.body.data.id.toString());
%}

### 通过任务 runner 触发真实插件服务调用
POST {{baseUrl}}/jobs/{{jobId}}/run
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "inputJson": "{\"serviceInstallationId\":\"{{serviceInstallation}}\"}",
  "timeoutMillis": 30000
}

> {%
client.test("服务调用任务已提交", function () {
  client.assert(response.body.code === 0);
  client.assert(!!response.body.data.executionId);
});
client.global.set("serviceExecutionId", response.body.data.executionId.toString());
%}

### 服务调用日志非空（任务刚提交时可稍后重跑此请求）
GET {{baseUrl}}/plugin-service/calls?callerInstallationId={{installationB}}&targetInstallationId={{serviceInstallation}}&operation=echo&page=1&size=20
Authorization: Bearer {{adminToken}}

> {%
client.test("真实服务调用日志非空", function () {
  client.assert(response.body.data.total >= 1);
  client.assert(response.body.data.items[0].success === true);
  client.assert(response.body.data.items[0].targetPluginId === "frontend-integration-service");
});
client.global.set("serviceCallId", response.body.data.items[0].id.toString());
%}

### 服务调用详情
GET {{baseUrl}}/plugin-service/calls/{{serviceCallId}}
Authorization: Bearer {{adminToken}}

> {% client.test("服务调用详情包含真实请求标识", function () { client.assert(!!response.body.data.serviceRequestId); client.assert(response.body.data.responseBytes > 0); }); %}

### 目标 SERVICE runner 日志
GET {{baseUrl}}/plugin-service/calls/{{serviceCallId}}/logs?tailBytes=65536
Authorization: Bearer {{adminToken}}

> {% client.test("SERVICE runner 日志可读", function () { client.assert(response.body.data.exists === true); client.assert(response.body.data.content.includes("frontend integration service")); }); %}

