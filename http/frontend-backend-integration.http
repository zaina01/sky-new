GET {{baseUrl}}/frontend-it-route-does-not-exist
Authorization: Bearer {{adminToken}}

> {% client.test("原生 404 统一封装", function () { client.assert(response.status === 404); client.assert(response.body.code === 404001); }); %}

### 使用转交前签发逻辑等价的 SELF 用户重新请求（无需因转交刷新权限模型）
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "username": "{{targetUsername}}",
  "password": "{{targetPassword}}"
}

> {% client.global.set("targetToken", response.body.data.token); %}

### SELF 用户立即看到转交后的实例
GET {{baseUrl}}/plugins/installations?page=1&size=20
Authorization: Bearer {{targetToken}}

> {% client.test("转交后实例立即可见", function () { client.assert(response.body.data.total === 1); }); %}

### SELF 用户当前权限和部门立即生效
GET {{baseUrl}}/user/me
Authorization: Bearer {{targetToken}}

> {% client.test("me 返回当前数据库权限", function () { client.assert(response.body.data.permissions.includes("plugin:runtime:read")); }); %}

### 创建实例 A 的账户分组（重复运行前先执行下方删除分组）
POST {{baseUrl}}/plugins/installations/{{installationA}}/account-groups
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name":"联调主账户"}

> {% client.test("分组创建", function () { client.assert(response.body.code === 0); }); client.global.set("accountGroupId", response.body.data.groupId); %}

### 分组列表含账户数量
GET {{baseUrl}}/plugins/installations/{{installationA}}/account-groups
Authorization: Bearer {{adminToken}}

### 单个账户加入分组
PATCH {{baseUrl}}/plugins/installations/{{installationA}}/accounts/account-a/group
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"groupId":{{accountGroupId}}}

> {% client.test("账户加入分组", function () { client.assert(response.body.data.groupId === Number(client.global.get("accountGroupId"))); }); %}

### 按组筛选（列表及导出均为最早创建在前）
GET {{baseUrl}}/plugins/installations/{{installationA}}/accounts?groupId={{accountGroupId}}&page=1&size=20
Authorization: Bearer {{adminToken}}

> {% client.test("分组筛选及 total", function () { client.assert(response.body.data.total === 1); client.assert(response.body.data.items[0].groupName === "联调主账户"); }); %}

### 按组导出，不增加分组列
GET {{baseUrl}}/plugins/installations/{{installationA}}/accounts/export?groupId={{accountGroupId}}&format=csv
Authorization: Bearer {{adminToken}}

### 分组重命名
PUT {{baseUrl}}/plugins/installations/{{installationA}}/account-groups/{{accountGroupId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name":"联调主账户改名"}

### 批量移出分组，显式 null 清空；省略 groupId 会返回 400
PATCH {{baseUrl}}/plugins/installations/{{installationA}}/accounts/group
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"accountIds":["account-a"],"groupId":null}

> {% client.test("批量移出", function () { client.assert(response.body.data.succeeded === 1); }); %}

### 查询未分组账户
GET {{baseUrl}}/plugins/installations/{{installationA}}/accounts?ungrouped=true&page=1&size=20
Authorization: Bearer {{adminToken}}

### 单个账户也可显式清空分组
PATCH {{baseUrl}}/plugins/installations/{{installationA}}/accounts/account-a/group
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"groupId":null}

### 删除分组（非空分组也可删除，账户保留并转为未分组）
DELETE {{baseUrl}}/plugins/installations/{{installationA}}/account-groups/{{accountGroupId}}
Authorization: Bearer {{adminToken}}
